{
  "name": "codex-react-native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ngrok": "^4.1.3",
    "axios": "^1.18.1",
    "expo": "57.0.20",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^57.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:sandbox": "node scripts/run-with-env.mjs sandbox expo start",
    "android": "expo start --android",
    "android:sandbox": "node scripts/run-with-env.mjs sandbox expo start --android",
    "ios": "expo start --ios",
    "ios:sandbox": "node scripts/run-with-env.mjs sandbox expo start --ios --port 8082 --clear",
    "web": "expo start --web",
    "web:sandbox": "node scripts/run-with-env.mjs sandbox expo start --web",
    "backend": "node backend/server.mjs",
    "test:backend": "node --test backend/test/*.test.mjs",
    "test:frontend": "node --experimental-default-type=module --experimental-strip-types --test scripts/test/*.test.mts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=11"
  },
  "private": true
}
